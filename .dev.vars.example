# Copie para .dev.vars (não vai para o Git) para rodar o painel localmente com `npm run dev`.
ADMIN_PASSWORD=troque-esta-senha-de-teste
SESSION_SECRET=gere-um-texto-aleatorio-com-pelo-menos-32-caracteres
